<Window x:Class="PrintInspector.MaskSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="掩膜参数" Width="510" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Microsoft YaHei UI"
        FontSize="16" Background="#F6FAF9" Foreground="#183840">
    <StackPanel Margin="22">
        <StackPanel x:Name="FabricSettings" Visibility="Collapsed">
            <TextBlock Text="自适应布底" FontSize="19" FontWeight="SemiBold"/>
            <DockPanel Margin="0,10,0,4">
                <TextBox x:Name="FabricThreshold" DockPanel.Dock="Right" Width="84" Padding="6,4" AutomationProperties.Name="前景阈值"/>
                <TextBlock Text="前景阈值" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="1～254。调大可压制成片误提，也可能漏掉浅色笔画。"
                       TextWrapping="Wrap" Foreground="#526765" FontSize="14"/>
            <DockPanel Margin="0,10,0,4">
                <TextBox x:Name="FabricArea" DockPanel.Dock="Right" Width="84" Padding="6,4" AutomationProperties.Name="去噪面积上限"/>
                <TextBlock Text="去噪面积上限（像素）" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="0～8192。仅处理未与大块图案相连的小块前景。0 关闭孤点过滤。"
                       TextWrapping="Wrap" Foreground="#526765" FontSize="14"/>
            <DockPanel Margin="0,10,0,4">
                <TextBox x:Name="FabricProtection" DockPanel.Dock="Right" Width="84" Padding="6,4" AutomationProperties.Name="小点保护分差"/>
                <TextBlock Text="小点保护分差" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="1～127。调大可过滤更多弱孤点。达到保护分的孤点以及有连续响应的细长笔画会保留。"
                       TextWrapping="Wrap" Foreground="#526765" FontSize="14"/>
        </StackPanel>
        <StackPanel x:Name="ForestSettings">
            <TextBlock Text="背景孤点" FontSize="19" FontWeight="SemiBold"/>
            <DockPanel Margin="0,10,0,4">
                <TextBox x:Name="Noise" DockPanel.Dock="Right" Width="84" Padding="6,4" AutomationProperties.Name="去噪面积上限"/>
                <TextBlock Text="去噪面积上限（像素）" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="0～1024。调大可筛查更大的孤点，也可能去掉细小印花。0 关闭孤点过滤。"
                       Foreground="#526765" TextWrapping="Wrap" FontSize="14"/>
            <Separator Margin="0,14"/>
            <TextBlock Text="前景内部空洞" FontSize="19" FontWeight="SemiBold"/>
            <DockPanel Margin="0,10,0,4">
                <TextBox x:Name="Holes" DockPanel.Dock="Right" Width="84" Padding="6,4" AutomationProperties.Name="补洞面积上限"/>
                <TextBlock Text="补洞面积上限（像素）" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="0～8192。仅考虑封闭孔洞；0 关闭补洞。" Foreground="#526765" FontSize="14"/>
            <DockPanel Margin="0,10,0,4">
                <TextBox x:Name="Allowance" DockPanel.Dock="Right" Width="84" Padding="6,4" AutomationProperties.Name="补洞证据容差"/>
                <TextBlock Text="补洞证据容差（灰度级）" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="0～255。调大允许较弱证据补洞。检查设计内孔和真实缺墨是否也被填上。"
                       TextWrapping="Wrap" Foreground="#526765" FontSize="14"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="#A22823" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" Content="恢复默认" Click="RestoreClick"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button IsCancel="True" Content="取消"/>
                <Button x:Name="ApplyButton" IsDefault="True" Margin="8,0,0,0" Background="#006B64"
                        Foreground="White" Click="ApplyClick" Content="应用并重跑"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
