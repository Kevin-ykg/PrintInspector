<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{61810EB1-FAAE-4B2B-9C57-19F81F7E9ABC}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props"/>
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props"/>
  <ImportGroup Label="PropertySheets">
    <Import Project="OpenCV.props"/>
  </ImportGroup>
  <PropertyGroup>
    <OutDir>$(ProjectDir)..\build\vs\$(Configuration)\native\</OutDir>
    <IntDir>$(ProjectDir)..\build\vs\obj\$(Configuration)\native\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level4</WarningLevel>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <!-- 保留调试运行库和 PDB；单步核查所有局部变量时可关闭 OptimizeVisionKernels。 -->
      <Optimization Condition="'$(Configuration)'=='Debug' and '$(OptimizeVisionKernels)'!='false'">MaxSpeed</Optimization>
      <BasicRuntimeChecks Condition="'$(Configuration)'=='Debug' and '$(OptimizeVisionKernels)'!='false'">Default</BasicRuntimeChecks>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="print.cpp"/>
    <ClCompile Include="refine.cpp"/>
    <ClInclude Include="print.hpp"/>
    <ClInclude Include="forest_votes.hpp"/>
    <ClInclude Include="refine.hpp"/>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets"/>
  <Target Name="CopyOpenCVRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(OpenCvRoot)\x64\vc15\bin\$(OpenCvName).dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"/>
  </Target>
</Project>
